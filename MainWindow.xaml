<Window x:Class="ExchangeRateGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Global Currency Converter" Height="350" Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ECEFF1" Padding="10" CornerRadius="4" Margin="0,0,0,20">
            <TextBlock x:Name="StatusDisplay" Text="Ready to connect. Click 'Fetch Live Rates' to start." 
                       FontWeight="Bold" Foreground="DarkSlateGray" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Enter Amount in USD ($):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333333"/>
            <TextBox x:Name="UsdInput" FontSize="16" Padding="5" Margin="0,0,0,15" Text="1,00"/>

            <TextBlock Text="Target Conversion Currency:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333333"/>
            <ComboBox x:Name="CurrencyDropdown" FontSize="14" Padding="5" Margin="0,0,0,20">
                <ComboBoxItem Content="TRY - Turkish Lira" IsSelected="True"/>
                <ComboBoxItem Content="EUR - Euro"/>
                <ComboBoxItem Content="JPY - Japanese Yen"/>
                <ComboBoxItem Content="GBP - British Pound"/>
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ResultDisplay" Grid.Column="0" Text="Result: --" 
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2E7D32"/>

            <Button x:Name="FetchButton" Grid.Column="1" Content="Fetch &amp; Convert" 
                    Width="150" Height="40" Background="DarkSlateGray" Foreground="White" 
                    FontWeight="Bold" Click="FetchButton_Click"/>
        </Grid>
    </Grid>
</Window>